FIREBASE_PROJECT_ID=hiera-sync
FIREBASE_PRIVATE_KEY_PATH=firebase-credentials.json
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO

# ---------- v2: storage, automation, notification gateways ----------
# auto = Firestore when credentials exist, else the embedded document store
DATABASE_BACKEND=auto
SQLITE_PATH=./var/hierasync.db
STATIC_DIR=../frontend/dist
SEED_DEMO_DATA=true
DEMO_PASSWORD=HierSync@123

# Scheduler / automation clock (10 jobs; see docs/06)
SCHEDULER_ENABLED=true
NOTIFY_TIMEZONE=Asia/Kolkata
# One time, or several that share the same minute ("08:00,17:00"); the deck's 8 AM is the first entry
DEADLINE_REMINDER_TIMES=08:00,17:00
OVERDUE_ESCALATION_TIME=09:00
WEEKLY_REPORT_TIME=Mon:07:00
RETENTION_PURGE_TIME=02:00
OUTBOX_POLL_SECONDS=20
OUTBOX_BATCH_SIZE=50
RISK_SWEEP_MINUTES=15

# Channels need no master switch: a provider is used as soon as its credentials are present,
# and anything unconfigured is written to the dev outbox instead (var/outbox/{email,sms,whatsapp}/).
NOTIFY_DEV_OUTBOX_DIR=./var/outbox
# Non-critical messages sent inside this window are deferred to its end (CRITICAL always breaks through)
DEFAULT_QUIET_HOURS=22:30-07:00
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_RETRY_BASE_SECONDS=60
NOTIFY_RATE_LIMIT_PER_MINUTE=40
NOTIFY_QUIET_HOURS=22:30-07:00
NOTIFY_SUPPRESS_WINDOW_MINUTES=360
NOTIFY_FAIL_SOFT=true
NOTIFY_RETENTION_DAYS=90

# Email - any SMTP relay (Gmail app password / Outlook / SES). SMTP_HOST set = provider goes live.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls          # none | starttls | ssl (465 usually means ssl)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=20
MAIL_FROM=no-reply@hierasync.local
MAIL_FROM_NAME="HieraSync Automation"
MAIL_REPLY_TO=
MAIL_SUBJECT_PREFIX=[HieraSync]
MAIL_HTML=true
MAIL_EMBED_TEXT_PLAIN=true
# set only if your host needs to force IPv4 out (some VPS + Gmail):
SMTP_LOCAL_ADDRESS=

# SMS (Twilio; the trial sandbox number is fine for a demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp - Meta Cloud API (WHATSAPP_PROVIDER=meta) or Twilio (twilio)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=meta          # meta | twilio
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TWILIO_FROM=           # e.g. whatsapp:+15005550001 (Twilio sandbox)
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Meta only lets business-initiated messages use PRE-APPROVED templates: map message kind -> template name
WHATSAPP_TEMPLATES={"deadline_risk":"risk_alert","task_overdue":"task_overdue","approval_request":"approval_request","escalation":"escalation","daily_digest":"daily_digest","default":"generic_alert"}

# Optional LLM for the assistant prose only (risk engine never calls it)
GEMINI_API_KEY=
OPENAI_API_KEY=
