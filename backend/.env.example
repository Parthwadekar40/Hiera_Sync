FIREBASE_PROJECT_ID=hiera-sync
FIREBASE_PRIVATE_KEY_PATH=firebase-credentials.json
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO

# ---------- v2: storage, automation, notification gateways ----------
# auto = Firestore when credentials exist, else the embedded document store
DATABASE_BACKEND=auto
SQLITE_PATH=./var/hierasync.db
STATIC_DIR=../frontend/dist
SEED_DEMO_DATA=true
DEMO_PASSWORD=password123

# Scheduler / automation clock (10 jobs; see docs/06)
SCHEDULER_ENABLED=true
NOTIFY_TIMEZONE=Asia/Kolkata
DEADLINE_REMINDER_TIMES=08:00,17:00
OVERDUE_ESCALATION_TIME=08:30
WEEKLY_REPORT_TIME=Mon:07:00
RETENTION_PURGE_TIME=02:00
OUTBOX_POLL_SECONDS=20
OUTBOX_BATCH_SIZE=50
RISK_SWEEP_MINUTES=15

# Channels: with no credentials the dev outbox writes real previews to
# NOTIFY_DEV_OUTBOX_DIR (email-*.html/.txt, sms-*.txt, whatsapp-*.txt)
NOTIFY_DEV_MODE=true
NOTIFY_DEV_OUTBOX_DIR=./var/outbox
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_RETRY_BASE_SECONDS=60
NOTIFY_RATE_LIMIT_PER_MINUTE=40
NOTIFY_QUIET_HOURS=22:30-07:00
NOTIFY_SUPPRESS_WINDOW_MINUTES=360
NOTIFY_FAIL_SOFT=true
NOTIFY_RETENTION_DAYS=90

# Email (SMTP relay: Gmail app password / Outlook / SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=HieraSync AI <no-reply@hierasync.local>

# SMS (Twilio; trial sandbox number is fine for a demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp (Meta WhatsApp Cloud API; templates must be approved by Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_HIGH=
WHATSAPP_TEMPLATE_MEDIUM=
WHATSAPP_TEMPLATE_LOW=

# Optional LLM for the assistant prose only (risk engine never calls it)
GEMINI_API_KEY=
OPENAI_API_KEY=
